 		if (++tail > RX_NUM) tail = 0;
 		uint32_t i = rx_list[tail];
 		rx_available -= rx_count[i] - rx_index[i];
 		rx_queue_transfer(i);
 		rx_tail = tail;
 	}
 }
 
 
 // get the next character, or -1 if nothing received
 int usb_serial2_getchar(void)
 {
 	uint8_t c;
 	if (usb_serial2_read(&c, 1)) return c;
 	return -1;
 }
 
 
 
 
 
 
 
 
 
 
 
 
 
