     uint8_t cmd[5] = { 't', ch, TUNING[ch][0], TUNING[ch][1], TUNING[ch][2] };
     CFT1.write(cmd, 5);
     #if NUM_COINFTS == 2
       CFT2.write(cmd, 5);
     #endif
     delay(50);
   }
 }
 
 void loop() {
+#ifdef USB_DUAL_SERIAL
+  ++diagLoopCount;
+#endif
   // 1. Listen for PC Commands
   if (Serial.available()) {
     char readChar = Serial.read();
 
     if (readChar == 'i') {
+#ifdef USB_DUAL_SERIAL
+      ++diagStops;
+#endif
       // Idle Command
       CFT1.write('i');
       #if NUM_COINFTS == 2
         CFT2.write('i');
       #endif
       myTimer.end(); // Stop the checker
       
       // Reset flags
       newData1 = false;
       #if NUM_COINFTS == 2
         newData2 = false;
       #endif
